# Checks what CMake embedded for the "what's new" popup, and the built Refarter.exe itself: neither may hold a link
# target or address from the release notes (a private release's notes link the private repository).
# cmake -DNOTES=<docs/releases/x.md> -DRESOURCE=<generated/release-notes.md> -DEXE=<Refarter.exe> -P release_notes_resource.cmake
cmake_minimum_required(VERSION 3.24)

file(READ ${RESOURCE} resource)
if(resource MATCHES "://|www\\.")
  message(FATAL_ERROR "${RESOURCE} holds an address")
endif()
if(resource MATCHES "mailto:|[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]")
  message(FATAL_ERROR "${RESOURCE} holds an e-mail address")
endif()
# The names the public publisher rejects in a binary: its team handles and allowed terms (read from the script
# itself, so the lists cannot drift apart), the private repository's owner, and the people in the git history. The
# publisher is not in the public source, so there this part checks nothing.
set(terms "")
set(allowed "")
get_filename_component(root ${CMAKE_CURRENT_LIST_DIR} DIRECTORY)
set(publisher ${root}/scripts/export-public-snapshot.ps1)
# The quoted values of one `$name = 'a', 'b'` line of the publisher.
function(publisher_values name out)
  file(STRINGS ${publisher} line REGEX "^\\$${name} *=")
  string(REGEX MATCHALL "'[^']+'" values "${line}")
  string(REPLACE "'" "" values "${values}")
  set(${out} "${values}" PARENT_SCOPE)
endfunction()
if(EXISTS ${publisher})
  publisher_values(teamHandles handles)
  list(APPEND terms ${handles})
  publisher_values(allowedTerms allowed)
  publisher_values(identityEmail identity)
  list(APPEND allowed ${identity})
endif()
find_package(Git QUIET)
if(GIT_FOUND AND EXISTS ${publisher})
  execute_process(COMMAND ${GIT_EXECUTABLE} -C ${root} config --get remote.origin.url OUTPUT_VARIABLE origin
    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(origin MATCHES "github\\.com[:/]([^/]+)/")
    list(APPEND terms "${CMAKE_MATCH_1}")
  endif()
  # As the publisher's Get-PrivateTerms: every author, committer and co-author, unless their address is a public one;
  # the name, its words of 4 letters or more, the address and its local part.
  execute_process(COMMAND ${GIT_EXECUTABLE} -C ${root} log --format=%an%x09%ae%n%cn%x09%ce OUTPUT_VARIABLE people ERROR_QUIET)
  execute_process(COMMAND ${GIT_EXECUTABLE} -C ${root} log "--format=%(trailers:key=Co-authored-by,valueonly)"
    OUTPUT_VARIABLE coauthors ERROR_QUIET)
  string(REGEX REPLACE "[ \t]*([^\n<]+[^ \n<])[ \t]*<([^>\n]+)>" "\\1\t\\2" coauthors "${coauthors}")
  string(REPLACE ";" "" everyone "${people}\n${coauthors}")
  string(REPLACE "\n" ";" everyone "${everyone}")
  list(REMOVE_DUPLICATES everyone)
  set(public noreply@github.com noreply@anthropic.com ${identity})
  foreach(person IN LISTS everyone)
    if(NOT person MATCHES "^([^\t]+)\t([^\t]+)$")
      continue()
    endif()
    set(name "${CMAKE_MATCH_1}")
    string(TOLOWER "${CMAKE_MATCH_2}" email)
    if(email IN_LIST public)
      continue()
    endif()
    list(APPEND terms "${name}" "${email}")
    string(REGEX MATCHALL "[^ ]+" words "${name}")
    foreach(word IN LISTS words)
      string(LENGTH "${word}" length)
      if(length GREATER_EQUAL 4)
        list(APPEND terms "${word}")
      endif()
    endforeach()
    string(REGEX REPLACE "@.*$" "" local "${email}")
    string(REGEX REPLACE "^[0-9]+\\+" "" local "${local}")
    string(LENGTH "${local}" length)
    if(length GREATER_EQUAL 4)
      list(APPEND terms "${local}")
    endif()
  endforeach()
endif()
string(TOLOWER "${resource}" lower)
string(TOLOWER "${allowed}" allowed)
list(REMOVE_DUPLICATES terms)
foreach(term IN LISTS terms)
  string(TOLOWER "${term}" term)
  if(term IN_LIST allowed)
    continue()
  endif()
  string(REGEX REPLACE "([][+.*()^$?|\\\\])" "\\\\\\1" pattern "${term}")
  if(lower MATCHES "(^|[^a-z0-9])${pattern}([^a-z0-9]|$)")
    message(FATAL_ERROR "${RESOURCE} names \"${term}\", which the public publisher rejects")
  endif()
endforeach()
list(LENGTH terms termCount)
message(STATUS "${termCount} private names, handles and addresses checked in the resource")
if(NOT EXISTS ${NOTES})
  message(STATUS "no release notes for this version: the resource is empty")
  return()
endif()

# Every address in the source notes: link targets and bare ones.
file(READ ${NOTES} notes)
string(REGEX MATCHALL "\\]\\([^)\n]+\\)" targets "${notes}")
string(REGEX MATCHALL "[A-Za-z][A-Za-z0-9+.-]*://[^ \t\r\n<>)]+|www\\.[^ \t\r\n<>)]+" bare "${notes}")
set(addresses "")
foreach(target IN LISTS targets)
  string(REGEX REPLACE "^\\]\\((.*)\\)$" "\\1" target "${target}")
  list(APPEND addresses "${target}")
endforeach()
list(APPEND addresses ${bare})
list(REMOVE_DUPLICATES addresses)

# The exe's printable runs, as a scanner of the published files reads them.
file(STRINGS ${EXE} strings LENGTH_MINIMUM 8)
foreach(address IN LISTS addresses)
  string(LENGTH "${address}" length)
  if(length LESS 8)
    continue() # Too short to tell apart from the exe's own text ("#top").
  endif()
  foreach(text IN LISTS strings)
    string(FIND "${text}" "${address}" at)
    if(NOT at EQUAL -1)
      message(FATAL_ERROR "${EXE} holds \"${address}\" from ${NOTES}")
    endif()
  endforeach()
endforeach()
list(LENGTH addresses count)
message(STATUS "${count} addresses from the notes, none in the resource or the exe")
